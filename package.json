{
  "name": "@nordicsemiconductor/thingy-rocks-cloud",
  "version": "0.0.0-development",
  "description": "Cloud backend for the thingy.rocks AWS IoT dashboard developed using AWS CDK in TypeScript.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --test ./**/*.spec.ts",
    "prepare": "husky && check-node-version --package",
    "build:container": "node --experimental-transform-types --no-warnings ./build-container.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js.git"
  },
  "bugs": {
    "url": "https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js/issues"
  },
  "homepage": "https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js#readme",
  "keywords": [
    "thingy-world",
    "iot",
    "aws",
    "cdk",
    "demo"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.750.0",
    "@aws-sdk/client-dynamodb": "3.751.0",
    "@aws-sdk/client-ecr": "3.750.0",
    "@aws-sdk/client-iot": "3.750.0",
    "@aws-sdk/client-iot-data-plane": "3.750.0",
    "@aws-sdk/client-s3": "3.750.0",
    "@aws-sdk/client-ssm": "3.750.0",
    "@aws-sdk/client-sts": "3.750.0",
    "@aws-sdk/client-timestream-query": "3.750.0",
    "@aws-sdk/util-dynamodb": "3.751.0",
    "@bifravst/aws-cdk-ecr-helpers": "1.3.59",
    "@bifravst/aws-cdk-lambda-helpers": "3.0.43",
    "@bifravst/eslint-config-typescript": "6.1.20",
    "@bifravst/prettier-config": "1.1.6",
    "@bifravst/run": "1.2.0",
    "@commitlint/config-conventional": "19.7.1",
    "@types/aws-lambda": "8.10.147",
    "@types/node": "22.13.4",
    "aws-cdk": "2.1000.2",
    "aws-cdk-lib": "2.179.0",
    "cdk": "2.1000.2",
    "chalk": "5.4.1",
    "check-node-version": "4.2.1",
    "commitlint": "19.7.1",
    "constructs": "10.4.2",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.5.1",
    "tsmatchers": "5.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=22.7.0",
    "npm": ">=10"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@bifravst/from-env": "3.0.2",
    "@bifravst/timestream-helpers": "6.1.0",
    "@hello.nrfcloud.com/lambda-helpers": "2.0.79",
    "@hello.nrfcloud.com/proto-map": "16.2.4",
    "@middy/core": "6.0.0",
    "@middy/input-output-logger": "6.0.0",
    "@nordicsemiconductor/from-env": "3.0.1",
    "@nordicsemiconductor/timestream-helpers": "6.0.2",
    "@sinclair/typebox": "0.34.27",
    "ajv": "8.17.1",
    "jsonata": "2.0.6",
    "p-retry": "6.2.1",
    "ulidx": "2.4.1"
  }
}
