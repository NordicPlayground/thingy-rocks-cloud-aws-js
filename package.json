{
  "name": "@nordicsemiconductor/thingy-rocks-cloud",
  "version": "0.0.0-development",
  "description": "Cloud backend for the thingy.rocks AWS IoT dashboard developed using AWS CDK in TypeScript.",
  "type": "module",
  "scripts": {
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules|e2e-tests)/**/*.spec.ts\"",
    "prepare": "husky && check-node-version --package",
    "build:container": "node --experimental-transform-types --no-warnings ./build-container.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js.git"
  },
  "bugs": {
    "url": "https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js/issues"
  },
  "homepage": "https://github.com/NordicPlayground/thingy-rocks-cloud-aws-js#readme",
  "keywords": [
    "thingy-world",
    "iot",
    "aws",
    "cdk",
    "demo"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.922.0",
    "@aws-sdk/client-dynamodb": "3.922.0",
    "@aws-sdk/client-ecr": "3.922.0",
    "@aws-sdk/client-iot": "3.922.0",
    "@aws-sdk/client-iot-data-plane": "3.922.0",
    "@aws-sdk/client-s3": "3.922.0",
    "@aws-sdk/client-ssm": "3.922.0",
    "@aws-sdk/client-sts": "3.922.0",
    "@aws-sdk/client-timestream-query": "3.922.0",
    "@aws-sdk/util-dynamodb": "3.922.0",
    "@bifravst/aws-cdk-ecr-helpers": "1.3.129",
    "@bifravst/aws-cdk-lambda-helpers": "3.5.84",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/prettier-config": "1.1.13",
    "@bifravst/run": "1.2.0",
    "@commitlint/config-conventional": "20.0.0",
    "@types/aws-lambda": "8.10.157",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "24.10.0",
    "aws-cdk": "2.1031.1",
    "aws-cdk-lib": "2.221.1",
    "cdk": "2.1031.1",
    "chalk": "5.6.2",
    "check-node-version": "4.2.1",
    "commitlint": "20.1.0",
    "constructs": "10.4.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=22.7.0",
    "npm": ">=10"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@bifravst/from-env": "3.0.2",
    "@bifravst/timestream-helpers": "6.1.0",
    "@hello.nrfcloud.com/lambda-helpers": "5.0.13",
    "@hello.nrfcloud.com/proto-map": "16.5.30",
    "@middy/core": "6.4.5",
    "@middy/input-output-logger": "6.4.5",
    "@nordicsemiconductor/from-env": "3.0.1",
    "@nordicsemiconductor/timestream-helpers": "6.0.2",
    "@protobuf-ts/runtime": "2.11.1",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.17.1",
    "aws-iot-device-sdk-v2": "1.23.1",
    "jsonata": "2.1.0",
    "lodash-es": "4.17.21",
    "mqtt": "5.14.1",
    "p-retry": "7.1.0",
    "p-throttle": "8.0.0",
    "ulidx": "2.4.1",
    "cbor": "10.0.11"
  }
}
